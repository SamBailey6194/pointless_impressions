# ---------- Stage 1: Build JS, CSS, and Collect Static ----------
# This stage installs all tools needed to build assets
FROM python:3.13-slim-bookworm AS builder

# Set env vars for build stage
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    NODE_VERSION=24.2.0 \
    NPM_VERSION=11.3.0 \
    # Set Django settings for collectstatic
    DJANGO_SETTINGS_MODULE=pointless_impressions_src.pointless_impressions.settings.production \
    # Tell Django it's in production mode
    DEBUG=False

WORKDIR /app

# Install all system dependencies FIRST (before any pip installs)
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    make \
    libpq-dev \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js
RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz -o node.tar.xz && \
    tar -xJf node.tar.xz -C /usr/local --strip-components=1 && \
    rm node.tar.xz && \
    npm install -g npm@${NPM_VERSION}

# Install UV (for Python)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Install Python dependencies
COPY requirements.txt .
RUN uv pip install --upgrade pip --system && \
    uv pip install -r requirements.txt --system

# Install Node dependencies
COPY package.json package-lock.json* ./
RUN npm ci

# Copy ALL source code
COPY pointless_impressions_src/ ./pointless_impressions_src/
COPY manage.py .

# Build CSS/JS only (collectstatic will run in entrypoint)
RUN npm run build

# ---------- Stage 2: Final Production Image ----------
# This stage ONLY installs Python. It is small and secure.
FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Gunicorn will be run by the 'appuser'
    USER=appuser \
    HOME=/home/appuser

WORKDIR /app

# 1. Install only necessary runtime dependencies (no Node.js)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 2. UV (for installing Gunicorn)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 3. Install Python dependencies (including Gunicorn)
COPY requirements.txt .
RUN uv pip install --upgrade pip --system && \
    uv pip install -r requirements.txt --system

# 4. Copy Django project (small layer)
COPY pointless_impressions_src/ ./pointless_impressions_src/
COPY manage.py .

# 5. Create non-root user and give it ownership
RUN useradd -m $USER && \
    chown -R $USER:$USER /app

# Make entrypoint executable
RUN chmod +x ./pointless_impressions_src/production-entrypoint.sh

# Switch to non-root user
USER $USER

EXPOSE 8000
HEALTHCHECK CMD curl -f http://localhost:8000/health/ || exit 1

# Run the entrypoint
CMD ["/app/pointless_impressions_src/production-entrypoint.sh"]
